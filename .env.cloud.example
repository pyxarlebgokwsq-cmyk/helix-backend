# --- Render.com / Cloud ---
CLOUD_MODE=1
PORT=3000
MONGO_URI=mongodb+srv://USER:PASS@cluster.mongodb.net/helix

# Matchmaker : URL publique vers /matchmaking sur ce serveur (HTTPS)
# Le jeu s'y connecte en WebSocket pour lancer la séquence de matchmaking
MATCHMAKER_IP=wss://ton-app.onrender.com/matchmaking

# Fallback statique (si aucun hote enregistre)
GAMESERVER_IP=127.0.0.1:7777

# API_KEY doit correspondre a la valeur dans globals.h / launcher
API_KEY=98e7S46tu08ert87uJ4Syt609_4589w3FmftlgDKFK

# Season / Evenement
EVENT_TYPE=Arena
MAIN_SEASON=12
BACKEND_NAME=MASTEROG

# Micro-services optionnels (non utilises en mode cloud v1)
# HYPE_PORT=90
# VBUCKS_PORT=92
# LAWWIN_PORT=94
# XMPP_PORT=70

# Discord bot (optionnel, silencieux si absent)
# BOT_TOKEN=
# CLIENT_ID=
# CLIENT_SECRET=
